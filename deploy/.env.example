# Settings of the online server. Copy this file to deploy/.env ON THE SERVER, fill it in, then: chmod 600 .env
# Never commit deploy/.env (it is in .gitignore) and never paste it anywhere.

# The address of the game server, without https://. Example: api.example.com
API_DOMAIN=

# The game page allowed to sign in, with https:// and without a final slash. Example: https://play.example.com
ALLOWED_ORIGINS=

# Your e-mail address, for Let's Encrypt (it writes only if a certificate cannot be renewed).
ACME_EMAIL=

# The database password. Make one on the server with:  openssl rand -hex 32
# Letters and digits only (hex), so it can sit inside the database address as it is.
POSTGRES_PASSWORD=

# The Solana network sign-in messages must name. Leave mainnet.
SIWS_CHAIN_ID=mainnet
