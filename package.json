{
  "name": "brinelight",
  "private": true,
  "version": "0.1.0",
  "description": "Brinelight: a mobile and web strategy game in a drowned world, notarized on Solana",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p shared && tsc -p client && tsc -p server && tsc -p e2e && tsc -p tools",
    "build": "npm run build -w client",
    "check": "npm run typecheck && npm test && npm run build",
    "e2e": "vitest run --config e2e/vitest.config.ts",
    "balance": "tsx tools/balance/run.ts",
    "study:depletion": "tsx tools/balance/depletion-run.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "playwright-core": "1.56.1",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
